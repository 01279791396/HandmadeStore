@using Microsoft.Extensions.Options
@using Microsoft.EntityFrameworkCore
@using HandmadeStore.Data
@inject IOptions<StoreSettings> StoreOptions
@inject AppDbContext Db
@{
    var store = StoreOptions.Value;
    var title = ViewData["Title"] as string;
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "";
    var newOrders = await Db.Orders.CountAsync(o => o.Status == OrderStatus.New);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#3a2a21" />
    <title>@(string.IsNullOrEmpty(title) ? "لوحة التحكم" : title) | لوحة التحكم</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="admin-body">
    <nav class="navbar navbar-expand-lg admin-navbar sticky-top" data-bs-theme="dark">
        <div class="container-fluid admin-container">
            <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-flower1"></i> @store.Name
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav"
                    aria-controls="adminNav" aria-expanded="false" aria-label="القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> الرئيسية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                            <i class="bi bi-receipt"></i> الطلبات
                            @if (newOrders > 0)
                            {
                                <span class="badge rounded-pill bg-danger">@newOrders</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index">
                            <i class="bi bi-box-seam"></i> المنتجات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Categories" ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-tags"></i> التصنيفات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Customers" ? "active" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Index">
                            <i class="bi bi-people"></i> العملاء
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center flex-wrap gap-2 pb-2 pb-lg-0">
                    <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                        <i class="bi bi-box-arrow-up-left"></i> عرض الموقع
                    </a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-box-arrow-right"></i> خروج</button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <main class="admin-main">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
