@model List<AdminCategoryRow>
@{
    ViewData["Title"] = "التصنيفات";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 fw-bold mb-0">التصنيفات</h1>
    <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg"></i> تصنيف جديد</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>الاسم</th><th class="d-none d-md-table-cell">الوصف</th><th>عدد المنتجات</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="fw-bold">@row.Category.Name</td>
                        <td class="d-none d-md-table-cell">@row.Category.Description</td>
                        <td>@row.ProductCount</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@row.Category.Id" class="btn btn-sm btn-outline-brand">تعديل</a>
                            <form asp-action="Delete" asp-route-id="@row.Category.Id" method="post" class="d-inline"
                                  data-confirm="متأكد إنك عايز تحذف التصنيف ده؟">
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">مفيش تصنيفات</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
