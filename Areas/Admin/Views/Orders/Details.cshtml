@model Order
@{
    ViewData["Title"] = "طلب " + Model.Code;
    var statuses = Enum.GetValues<OrderStatus>();
    var invoiceMsg = Model.HasInvoice
        ? Uri.EscapeDataString("أهلًا " + Model.CustomerName + "، فاتورة طلبك " + Model.Code + " (" + Model.InvoiceNumber + ") جاهزة، تقدر تشوفها من حسابك في الموقع. الإجمالي " + Fmt.Price(Model.Total))
        : "";
    var whatsappPhone = Model.Phone.StartsWith("0") ? "20" + Model.Phone.Substring(1) : Model.Phone;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 fw-bold mb-0">طلب <span dir="ltr">@Model.Code</span></h1>
    <a asp-action="Index" class="btn btn-outline-secondary">رجوع للطلبات</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header fw-bold">المنتجات</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>المنتج</th><th>السعر</th><th>الكمية</th><th>الإجمالي</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@Fmt.Price(item.UnitPrice)</td>
                                <td>@item.Quantity</td>
                                <td>@Fmt.Price(item.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="3">إجمالي المنتجات</td><td>@Fmt.Price(Model.Subtotal)</td></tr>
                        <tr><td colspan="3">@(Model.DeliveryMethod == DeliveryMethod.Pickup ? "استلام من المتجر" : "مصاريف التوصيل")</td><td>@(Model.DeliveryMethod == DeliveryMethod.Pickup ? "—" : (Model.DeliveryFee == 0 ? "مجاني" : Fmt.Price(Model.DeliveryFee)))</td></tr>
                        <tr class="fw-bold"><td colspan="3">الإجمالي</td><td>@Fmt.Price(Model.Total)</td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="summary-card mb-3">
            <h2 class="h6 fw-bold">بيانات العميل</h2>
            <div class="mb-1"><i class="bi bi-person"></i> @Model.CustomerName @if (Model.CustomerId != null) { <span class="badge text-bg-success ms-1">حساب مسجّل</span> }</div>
            <div class="mb-1">
                <i class="bi bi-telephone"></i> <a href="tel:@Model.Phone" dir="ltr">@Model.Phone</a>
                <a href="https://wa.me/@whatsappPhone" target="_blank" rel="noopener" class="ms-2 text-success"><i class="bi bi-whatsapp"></i></a>
            </div>
            <div class="mb-1">
                <i class="bi @(Model.DeliveryMethod == DeliveryMethod.Pickup ? "bi-shop" : "bi-truck")"></i>
                <strong>@(Model.DeliveryMethod == DeliveryMethod.Pickup ? "استلام من المتجر" : "توصيل")</strong>
            </div>
            <div class="mb-1"><i class="bi bi-geo-alt"></i> @Model.Address</div>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="mt-2 p-2 bg-light rounded"><i class="bi bi-chat-text"></i> @Model.Notes</div>
            }
            <div class="text-muted small mt-2">تاريخ الطلب: @Fmt.Date(Model.CreatedAt)</div>
        </div>

        <div class="summary-card mb-3">
            <h2 class="h6 fw-bold"><i class="bi bi-receipt"></i> الفاتورة</h2>
            @if (Model.HasInvoice)
            {
                <div class="mb-2">رقم <span dir="ltr" class="fw-bold">@Model.InvoiceNumber</span><br /><span class="text-muted small">صدرت: @Fmt.Date(Model.InvoiceIssuedAt!.Value)</span></div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-brand"><i class="bi bi-printer"></i> عرض / طباعة / PDF</a>
                    <a href="https://wa.me/@whatsappPhone?text=@invoiceMsg" target="_blank" rel="noopener" class="btn btn-outline-success"><i class="bi bi-whatsapp"></i> ابعتها واتساب</a>
                </div>
                <div class="small text-muted mt-2">العميل بيشوفها في حسابه (طلباتي ← الطلب ← الفاتورة).</div>
            }
            else
            {
                <p class="small text-muted mb-2">لسه مفيش فاتورة للطلب ده. لما تصدرها هتظهر للعميل في حسابه وتقدر تطبعها أو تحفظها PDF.</p>
                <form asp-action="IssueInvoice" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-brand w-100"><i class="bi bi-receipt"></i> إصدار فاتورة</button>
                </form>
            }
        </div>

        <div class="summary-card">
            <h2 class="h6 fw-bold">حالة الطلب</h2>
            <div class="mb-3"><span class="badge fs-6 @Fmt.StatusBadge(Model.Status)">@Fmt.StatusText(Model.Status)</span></div>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <select name="status" class="form-select">
                    @foreach (var s in statuses)
                    {
                        <option value="@((int)s)" selected="@(s == Model.Status)">@Fmt.StatusText(s)</option>
                    }
                </select>
                <button type="submit" class="btn btn-brand text-nowrap">تحديث</button>
            </form>
        </div>
    </div>
</div>
