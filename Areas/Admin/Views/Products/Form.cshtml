@model ProductFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "منتج جديد" : "تعديل منتج";
}

<h1 class="h3 fw-bold mb-3">@ViewData["Title"]</h1>

<form asp-action="Save" method="post" enctype="multipart/form-data" class="summary-card" style="max-width: 820px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImage" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" type="number" step="0.01" min="1" class="form-control" />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="(SelectList)ViewBag.Categories" class="form-select"></select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PrepDays" class="form-label"></label>
            <input asp-for="PrepDays" type="number" min="0" max="90" class="form-control" />
            <span asp-validation-for="PrepDays" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Image" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.ExistingImage))
        {
            <div class="mb-2">
                <img src="/uploads/@Model.ExistingImage" alt="" class="admin-preview" />
                <div class="form-check mt-1">
                    <input asp-for="RemoveImage" class="form-check-input" />
                    <label asp-for="RemoveImage" class="form-check-label"></label>
                </div>
            </div>
        }
        <input asp-for="Image" type="file" accept="image/*" class="form-control" />
        <div class="form-text">أي صورة (JPG, PNG, WEBP, GIF, BMP, AVIF)، بحد أقصى 20 ميجا.</div>
        <span asp-validation-for="Image" class="text-danger small"></span>
    </div>

    <div class="d-flex flex-wrap gap-4 mb-4">
        <div class="form-check">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label"></label>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-brand">حفظ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>
