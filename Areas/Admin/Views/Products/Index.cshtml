@model AdminProductListViewModel
@{
    ViewData["Title"] = "المنتجات";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 fw-bold mb-0">المنتجات</h1>
    <a class="btn btn-brand" asp-action="Create"><i class="bi bi-plus-lg"></i> منتج جديد</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-8 col-md-4">
        <input type="search" name="q" value="@Model.Q" class="form-control" placeholder="بحث بالاسم..." />
    </div>
    <div class="col-4 col-md-2">
        <button type="submit" class="btn btn-outline-brand w-100">بحث</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th></th><th>الاسم</th><th class="d-none d-md-table-cell">التصنيف</th><th>السعر</th><th>الحالة</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td><img src="@p.ImageUrl" alt="" class="admin-thumb" /></td>
                        <td>
                            @p.Name
                            @if (p.IsFeatured) { <span class="badge text-bg-warning">مميز</span> }
                        </td>
                        <td class="d-none d-md-table-cell">@(p.Category?.Name)</td>
                        <td>@Fmt.Price(p.Price)</td>
                        <td>
                            @if (p.IsAvailable) { <span class="badge text-bg-success">متاح</span> }
                            else { <span class="badge text-bg-secondary">غير متاح</span> }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-brand">تعديل</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                  data-confirm="متأكد إنك عايز تحذف المنتج ده؟">
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Products.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">مفيش منتجات</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="Model.Pager" />
