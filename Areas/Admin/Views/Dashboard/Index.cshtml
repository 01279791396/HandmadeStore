@model DashboardStats
@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0">أهلًا @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</h1>
        <div class="text-muted small">ملخص سريع لحالة المتجر</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-brand" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-lg"></i> منتج جديد</a>
        <a class="btn btn-outline-brand" asp-controller="Categories" asp-action="Create"><i class="bi bi-plus-lg"></i> تصنيف جديد</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <a asp-controller="Orders" asp-action="Index" asp-route-status="0" class="stat-card stat-link">
            <span class="stat-icon bg-warn"><i class="bi bi-bell"></i></span>
            <div><div class="stat-num">@Model.NewOrders</div><div class="text-muted small">طلبات جديدة</div></div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Orders" asp-action="Index" class="stat-card stat-link">
            <span class="stat-icon bg-info-soft"><i class="bi bi-receipt"></i></span>
            <div><div class="stat-num">@Model.Orders</div><div class="text-muted small">كل الطلبات</div></div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Products" asp-action="Index" class="stat-card stat-link">
            <span class="stat-icon bg-brand-soft"><i class="bi bi-box-seam"></i></span>
            <div><div class="stat-num">@Model.Products</div><div class="text-muted small">المنتجات</div></div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Customers" asp-action="Index" class="stat-card stat-link">
            <span class="stat-icon bg-sage-soft"><i class="bi bi-people"></i></span>
            <div><div class="stat-num">@Model.Customers</div><div class="text-muted small">العملاء</div></div>
        </a>
    </div>
    <div class="col-12">
        <div class="stat-card">
            <span class="stat-icon bg-sage-soft"><i class="bi bi-cash-stack"></i></span>
            <div><div class="stat-num">@Fmt.Price(Model.Revenue)</div><div class="text-muted small">إيرادات الطلبات المسلّمة</div></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">آخر الطلبات</span>
        <a asp-controller="Orders" asp-action="Index" class="small">عرض الكل</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>الكود</th><th>العميل</th><th>الإجمالي</th><th>الحالة</th><th class="d-none d-md-table-cell">التاريخ</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Recent)
                {
                    <tr>
                        <td dir="ltr" class="text-end fw-bold">@o.Code</td>
                        <td>@o.CustomerName</td>
                        <td>@Fmt.Price(o.Total)</td>
                        <td><span class="badge @Fmt.StatusBadge(o.Status)">@Fmt.StatusText(o.Status)</span></td>
                        <td class="d-none d-md-table-cell">@Fmt.Date(o.CreatedAt)</td>
                        <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-brand">عرض</a></td>
                    </tr>
                }
                @if (Model.Recent.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">مفيش طلبات لسه</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
