@model TrackViewModel
@{
    ViewData["Title"] = "تتبع طلبي";
}

<div class="container" style="max-width: 680px;">
    <h1 class="section-title">تتبع طلبي</h1>

    <form asp-action="Index" method="post" class="summary-card mb-4">
        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" dir="ltr" autocomplete="off" placeholder="HM-XXXXXX" />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" dir="ltr" inputmode="tel" placeholder="01xxxxxxxxx" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-brand w-100">بحث</button>
    </form>

    @if (Model.Searched)
    {
        if (Model.Result == null)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i> مفيش طلب بالبيانات دي. اتأكد من الكود (مثال: HM-K7P3QX) ومن رقم الموبايل اللي كتبته وقت الطلب.
            </div>
        }
        else
        {
            var order = Model.Result;
            <div class="summary-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">طلب <span dir="ltr">@order.Code</span></h2>
                    <span class="badge fs-6 @Fmt.StatusBadge(order.Status)">@Fmt.StatusText(order.Status)</span>
                </div>
                <div class="text-muted small mb-3">تاريخ الطلب: @Fmt.Date(order.CreatedAt)</div>
                <div class="mb-3"><partial name="_OrderTimeline" model="order.Status" /></div>
        <partial name="_OrderTotals" model="order" />
            </div>
        }
    }
</div>
