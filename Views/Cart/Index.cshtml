@model CartViewModel
@{
    ViewData["Title"] = "السلة";
}

<div class="container">
    <h1 class="section-title">سلة المشتريات</h1>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-bag display-3 text-muted"></i>
            <p class="mt-3 lead">السلة فاضية</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-brand">ابدأ التسوق</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-item d-flex gap-3 align-items-center">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Product.Id">
                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="cart-img" />
                        </a>
                        <div class="flex-grow-1">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Product.Id"
                               class="fw-bold text-dark text-decoration-none">@item.Product.Name</a>
                            <div class="text-muted small">@Fmt.Price(item.Product.Price) للقطعة</div>
                            @if (!item.Product.IsAvailable)
                            {
                                <div class="text-danger small">المنتج ده لم يعد متاحًا، احذفه عشان تكمل الطلب</div>
                            }
                            <form asp-action="Update" method="post" class="d-flex gap-2 mt-2 align-items-center">
                                <input type="hidden" name="productId" value="@item.Product.Id" />
                                <input type="number" name="quantity" value="@item.Quantity" min="0" max="20"
                                       class="form-control form-control-sm qty-input" aria-label="الكمية" />
                                <button type="submit" class="btn btn-sm btn-outline-brand">تحديث</button>
                            </form>
                        </div>
                        <div class="text-end">
                            <div class="price mb-2">@Fmt.Price(item.LineTotal)</div>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.Product.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="summary-card">
                    <h2 class="h5 fw-bold">ملخص الطلب</h2>
                    <div class="d-flex justify-content-between my-3">
                        <span>عدد القطع</span><span>@Model.Count</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>الإجمالي</span><span class="price">@Fmt.Price(Model.Total)</span>
                    </div>
                    <p class="small text-muted mt-2">الدفع عند الاستلام. مصاريف التوصيل بتظهر في الخطوة الجاية حسب طريقة الاستلام (توصيل أو استلام من المتجر).</p>
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-brand w-100 btn-lg">إتمام الطلب</a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-link w-100 mt-1">كمّل تسوق</a>
                </div>
            </div>
        </div>
    }
</div>
