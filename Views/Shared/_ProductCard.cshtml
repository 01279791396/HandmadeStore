@model Product
@{
    var returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;
}
<div class="card product-card h-100">
    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="product-img-wrap">
        <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" class="product-img" />
        @if (!Model.IsAvailable)
        {
            <span class="badge ribbon text-bg-dark">تم البيع</span>
        }
        else if (Model.IsFeatured)
        {
            <span class="badge ribbon text-bg-warning">مميز</span>
        }
    </a>
    <div class="card-body d-flex flex-column">
        @if (Model.Category != null)
        {
            <small class="text-muted">@Model.Category.Name</small>
        }
        <h3 class="h6 fw-bold mb-1">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">@Model.Name</a>
        </h3>
        <div class="price mb-3">@Fmt.Price(Model.Price)</div>

        @if (Model.IsAvailable)
        {
            <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-brand w-100"><i class="bi bi-bag-plus"></i> أضف للسلة</button>
            </form>
        }
        else
        {
            <button class="btn btn-secondary w-100 mt-auto" disabled>غير متاح حاليًا</button>
        }
    </div>
</div>
