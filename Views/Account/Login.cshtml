@model LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="container">
    <div class="auth-card">
        <div class="auth-head">
            <div class="auth-icon"><i class="bi bi-person-heart"></i></div>
            <h1 class="h4 fw-bold mb-1">أهلًا بيك من تاني</h1>
            <p class="text-muted mb-0">سجّل دخولك عشان تتصفح المتجر وتتابع طلباتك</p>
        </div>

        <ul class="auth-tabs">
            <li class="active"><a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">تسجيل الدخول</a></li>
            <li><a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">حساب جديد</a></li>
        </ul>

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="Identifier" class="form-label"></label>
                <input asp-for="Identifier" class="form-control" dir="ltr" autocomplete="username" autofocus />
                <span asp-validation-for="Identifier" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group" dir="ltr">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="#Password" aria-label="إظهار كلمة السر">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-brand btn-lg w-100">دخول</button>
        </form>

        <p class="text-center text-muted small mt-3 mb-0">
            لسه معندكش حساب؟ <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">سجّل حساب جديد</a>
        </p>
    </div>
</div>
