@model AccountIndexViewModel
@{
    ViewData["Title"] = "حسابي";
    var c = Model.Customer;
    var initial = string.IsNullOrWhiteSpace(c.Name) ? "؟" : c.Name.Trim().Substring(0, 1);
}

<div class="container">
    <div class="account-hero">
        <div class="avatar">@initial</div>
        <div class="flex-grow-1">
            <h1 class="h4 fw-bold mb-1">أهلًا @c.Name</h1>
            <div class="text-muted small"><i class="bi bi-telephone"></i> <span dir="ltr">@c.Phone</span></div>
            @if (!string.IsNullOrWhiteSpace(c.Email))
            {
                <div class="text-muted small"><i class="bi bi-envelope"></i> <span dir="ltr">@c.Email</span></div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Orders" class="btn btn-sm btn-brand"><i class="bi bi-bag-check"></i> طلباتي</a>
            <a asp-action="Profile" class="btn btn-sm btn-outline-brand"><i class="bi bi-pencil"></i> تعديل بياناتي</a>
            <a asp-action="ChangePassword" class="btn btn-sm btn-outline-brand"><i class="bi bi-key"></i> تغيير كلمة السر</a>
        </div>
    </div>

    <h2 class="section-title">آخر طلباتي</h2>

    @if (Model.Orders.Count == 0)
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-bag-heart display-3 text-muted"></i>
            <p class="mt-3 lead">لسه معملتش أي طلب</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-brand">ابدأ التسوق</a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var o in Model.Orders.Take(3))
            {
                <a asp-action="OrderDetails" asp-route-id="@o.Id" class="order-row">
                    <div>
                        <div class="order-row-code" dir="ltr">@o.Code</div>
                        <div class="text-muted small">@Fmt.Date(o.CreatedAt) · @o.Items.Sum(i => i.Quantity) قطعة</div>
                    </div>
                    <div class="text-end">
                        <div class="price">@Fmt.Price(o.Total)</div>
                        <span class="badge @Fmt.StatusBadge(o.Status)">@Fmt.StatusText(o.Status)</span>
                    </div>
                </a>
            }
        </div>
        <div class="text-center mt-3">
            <a asp-action="Orders" class="btn btn-brand">كل طلباتي (@Model.Orders.Count)</a>
        </div>
    }
</div>
