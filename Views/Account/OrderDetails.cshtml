@model Order
@{
    ViewData["Title"] = "طلب " + Model.Code;
}

<div class="container" style="max-width: 760px;">
    <a asp-action="Orders" class="text-decoration-none"><i class="bi bi-arrow-right"></i> رجوع لطلباتي</a>

    <div class="summary-card mt-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <div class="text-muted small">كود الطلب</div>
                <div class="order-row-code fs-4" dir="ltr">@Model.Code</div>
            </div>
            <span class="badge fs-6 @Fmt.StatusBadge(Model.Status)">@Fmt.StatusText(Model.Status)</span>
        </div>

        <partial name="_OrderTimeline" model="Model.Status" />

        <hr />

        <partial name="_OrderTotals" model="Model" />

        <div class="mt-3 small text-muted">
            <div><i class="bi bi-calendar3"></i> @Fmt.Date(Model.CreatedAt)</div>
            <div>
                <i class="bi @(Model.DeliveryMethod == DeliveryMethod.Pickup ? "bi-shop" : "bi-truck")"></i>
                @(Model.DeliveryMethod == DeliveryMethod.Pickup ? "استلام من المتجر" : "توصيل")
            </div>
            <div><i class="bi bi-geo-alt"></i> @Model.Address</div>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div><i class="bi bi-chat-text"></i> @Model.Notes</div>
            }
        </div>

        @if (Model.HasInvoice)
        {
            <div class="mt-3 d-grid">
                <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-brand">
                    <i class="bi bi-receipt"></i> عرض الفاتورة @Model.InvoiceNumber
                </a>
            </div>
        }
    </div>
</div>
