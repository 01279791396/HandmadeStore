@model Order
@{
    ViewData["Title"] = "تم استلام طلبك";
}

<div class="container" style="max-width: 720px;">
    <div class="text-center mb-4">
        <i class="bi bi-check-circle-fill display-2 text-success"></i>
        <h1 class="h3 fw-bold mt-2">شكرًا ليك! تم استلام طلبك</h1>
        <p class="text-muted">هنتواصل معاك قريب لتأكيد الطلب.</p>
    </div>

    <div class="summary-card">
        <div class="text-center mb-3">
            <div class="text-muted">كود الطلب (احتفظ بيه لتتبع الطلب)</div>
            <div class="order-code" dir="ltr" id="orderCode">@Model.Code</div>
            <button type="button" class="btn btn-sm btn-outline-brand mt-2" data-copy="#orderCode">
                <i class="bi bi-clipboard"></i> <span>نسخ الكود</span>
            </button>
        </div>

        <partial name="_OrderTotals" model="Model" />
        <div class="mt-3">
            الحالة: <span class="badge @Fmt.StatusBadge(Model.Status)">@Fmt.StatusText(Model.Status)</span>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
        <a asp-controller="Account" asp-action="Orders" class="btn btn-outline-brand">طلباتي</a>
        <a asp-controller="Track" asp-action="Index" asp-route-code="@Model.Code" class="btn btn-outline-brand">تتبع طلبي</a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-brand">كمّل تسوق</a>
    </div>
</div>
